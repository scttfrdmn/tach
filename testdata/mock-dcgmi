#!/usr/bin/env bash
# Mock of `dcgmi dmon` for tach's end-to-end tests.
#   MOCK_SCENARIO = fp64 (default) | starved | ai_fp32
#   MOCK_NOPROF=1  profiling fields print N/A
#   MOCK_MIG=1     also print two GPU-I rows
#   MOCK_ENERGY    path of the energy counter state file
#   MOCK_NOENERGY=1  the energy counter (field 156) prints N/A
#   MOCK_FAIL=1    behave like dcgmi with no nv-hostengine: print an error, exit 255
#   MOCK_FAIL_STREAM=1  short queries work, a streaming dmon (no -c) fails at once
#   MOCK_PROF_ERROR=1   a query for profiling fields (1001-1012) errors instead of printing N/A
#   MOCK_UNSUPPORTED=1006,...  any query that includes one of these fields fails as
#                  DCGM 4.7 does on an L40S for fp64_active
if [ "${MOCK_FAIL:-0}" = "1" ]; then
  echo "Error: unable to establish a connection to the specified host: localhost"
  echo "Error: Unable to connect to host engine. Host engine connection invalid/disconnected."
  exit 255
fi
[ "$1" = "dmon" ] || { echo "mock dcgmi: only dmon" >&2; exit 1; }
shift
ids=""; ms=1000; count=0
while [ $# -gt 0 ]; do
  case "$1" in
    -e) ids="$2"; shift 2;; -d) ms="$2"; shift 2;; -c) count="$2"; shift 2;; -i) shift 2;; *) shift;;
  esac
done
if [ "${MOCK_FAIL_STREAM:-0}" = "1" ] && [ "$count" -eq 0 ]; then
  echo "Error: mock stream failure: host engine connection lost" >&2
  exit 1
fi
for u in $(echo "${MOCK_UNSUPPORTED:-}" | tr , ' '); do
  case ",$ids," in *",$u,"*)
    echo "Error setting watches. Result: -6: Feature not supported"
    exit 255;;
  esac
done
if [ "${MOCK_PROF_ERROR:-0}" = "1" ]; then
  case ",$ids," in *,100[0-9],*|*,101[0-2],*)
    echo "Error setting watches. Result: The requested function is not supported."
    exit 255;;
  esac
fi
scen="${MOCK_SCENARIO:-fp64}"
efile="${MOCK_ENERGY:-/tmp/mock_energy}"
val() {
  local id=$1 ent=$2
  if [ "$id" -ge 1001 ] && [ "$id" -le 1012 ] && [ "${MOCK_NOPROF:-0}" = "1" ]; then echo N/A; return; fi
  case "$scen:$id" in
    starved:1002) echo 0.12;; starved:1003) echo 0.05;; starved:1004) echo 0.00;; starved:1005) echo 0.04;;
    starved:1006) echo 0.000;; starved:1009) echo 4.1e10;; starved:1010) echo 5.0e9;;
    ai_fp32:1002) echo 0.81;; ai_fp32:1003) echo 0.45;; ai_fp32:1004) echo 0.01;; ai_fp32:1005) echo 0.35;;
    ai_fp32:1006) echo 0.000;;
    *:1002) echo 0.85;; *:1003) echo 0.40;; *:1004) echo 0.02;; *:1005) echo 0.30;; *:1006) echo 0.20;;
    *:1007) echo 0.50;; *:1008) echo 0.00;; *:1009) echo 2.0e9;; *:1010) echo 5.0e9;;
    *:155) echo 250.5;; *:100) echo 2100;; *:252) echo 6000;; *:250) echo 46068;; *:203) echo 100;; *:150) echo 55;;
    *:156) [ "${MOCK_NOENERGY:-0}" = "1" ] && { echo N/A; return; }
           e=$(cat "$efile" 2>/dev/null || echo 1000000); echo "$e"; echo $((e + 500000)) > "$efile";;
    *) echo N/A;;
  esac
}
IFS=, read -ra F <<< "$ids"
printf '#Entity   ID'; for i in "${F[@]}"; do printf '  F%s' "$i"; done; echo
echo 'ID'
n=0
while :; do
  ents=("GPU 0")
  [ "${MOCK_MIG:-0}" = "1" ] && ents+=("GPU-I 0" "GPU-I 1")
  for e in "${ents[@]}"; do
    line="$e"
    for i in "${F[@]}"; do
      if [ "$i" = 156 ] && [ "${e%% *}" != "GPU" ]; then line="$line   N/A"; else line="$line   $(val "$i" "$e")"; fi
    done
    echo "$line"
  done
  n=$((n+1))
  [ "$count" -gt 0 ] && [ "$n" -ge "$count" ] && exit 0
  sleep "$(awk "BEGIN{print $ms/1000}")"
done
